<plist version="1.0">
<dict>
    <!--
      App Sandbox is left OFF for local development so ScreenCaptureKit can
      capture system audio without extra configuration. If you later want to
      distribute this app, enable the sandbox and add the appropriate
      screen-capture / audio entitlements.
    -->
</dict>
</plist>
